.claude/state/
.task/

# Python artifacts. These patterns used to live in `bot/.gitignore`, which
# went with the extracted bot — `bot-tools/` is now the repo's only Python
# tree, and without them a `git add -A` sweeps compiled bytecode into the
# index (it did, in the switchover commit).
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
/demo/
/.golden-baseline/
/node_modules/
# Build output (taskfile.yml RENDER_OUT, also `ocx-catalog build`'s default).
/dist/
# Generated per-build source-path override (RENDER_INDEX_DIR demo switch —
# see taskfile.yml site:build/site:dev).
/.catalog.config.render.json
# Per-machine renderer-switch defaults (see taskfile.yml).
/.env.local

# Ephemeral agent worktrees — never tracked, keep `git status` clean.
.agents/worktrees/
.claude/worktrees/
# site:preview's /catalog/ mount of dist/.
/.preview/
